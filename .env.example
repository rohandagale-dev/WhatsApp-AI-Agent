# ----------------------------- AI MODEL SELECTION -----------------------------
# AI_VERSION picks the model PROVIDER:
#   v1 = Gemini (default)   v2 = Groq   v3 = local Ollama
# Anything unrecognised is treated as v1.
AI_VERSION=

# ----------------------------- SYSTEM PROMPT SELECTION -----------------------------
# SYSTEM_PROMPT_VERSION picks which system_prompts/system_prompt_<version>.txt is
# loaded as the agent persona: v1 | v2 | v3. Defaults to v3. A missing file falls
# back to a one-line inline prompt (and logs a warning), it does not crash.
#
# !! READ THIS BEFORE CHANGING EITHER OF THE TWO SETTINGS ABOVE !!
# AI_VERSION and SYSTEM_PROMPT_VERSION are TWO DIFFERENT AXES that happen to
# share the same v1/v2/v3 names. This has already confused people on this project.
#   AI_VERSION           -> WHICH PROVIDER ANSWERS  (v1 Gemini / v2 Groq / v3 Ollama)
#   SYSTEM_PROMPT_VERSION-> WHICH PROMPT FILE LOADS (system_prompt_v1/v2/v3.txt)
# AI_VERSION=v3 + SYSTEM_PROMPT_VERSION=v1 is perfectly legal: Ollama answering
# with the v1 persona text. Changing one NEVER changes the other.
SYSTEM_PROMPT_VERSION=v3

# ----------------------------- API KEYS -----------------------------
# Gemini API Key (required when AI_VERSION=v1)
GEMINI_API_KEY=

# Groq API Key (required when AI_VERSION=v2)
GROQ_API_KEY=

# ----------------------------- SAMPLING (ALL THREE PROVIDERS) -----------------------------
# These two are read identically by geminiService, groqService and ollamaService.
# Anything unparseable or out of range silently falls back to the default.

# AI_TEMPERATURE - float in 0..2, default 0.4.
# The agent imitates one specific person's terse WhatsApp voice, it does not write
# prose. Lower = tracks that voice more faithfully but repeats stock phrasings;
# higher (0.8+) lets the model invent its own register and drift into
# generic-assistant tone, which is the exact bug the low default exists to avoid.
AI_TEMPERATURE=0.4

# AI_MAX_TOKENS - positive int, default 256. Budget for VISIBLE output only.
#   gemini -> generationConfig.maxOutputTokens (plus the thinking reserve below)
#   groq   -> max_completion_tokens
#   ollama -> options.num_predict
# Replies should be 2-8 words, so a big cap buys nothing but room to ramble.
# Too low and replies get cut off mid-sentence (Gemini logs a MAX_TOKENS warning).
AI_MAX_TOKENS=256

# ----------------------------- GEMINI SETTINGS -----------------------------
# GEMINI_MODEL - model id, default 'gemini-2.5-flash'. whatsappService stores this
# same value in chats.metadata.model, so both stay in sync automatically.
GEMINI_MODEL=gemini-2.5-flash

# GEMINI_THINKING_BUDGET - internal "thinking" token budget, default 0 (thinking OFF).
# gemini-2.5-* bills thinking tokens against the SAME output budget as visible text,
# so with thinking on and a small AI_MAX_TOKENS the model can spend the whole budget
# reasoning and return finishReason MAX_TOKENS with no text at all -- which fails the
# provider contract and makes the agent send nothing. Hence the default of 0: a 2-8
# word WhatsApp reply needs no reasoning trace. Whenever thinking IS enabled its
# budget is added ON TOP of AI_MAX_TOKENS, so visible output always keeps its room.
# Accepted values:
#   0      thinking off. Supported by gemini-2.5-flash and flash-lite. (default)
#   N > 0  cap thinking at N tokens. Costs N extra tokens per request.
#   -1     dynamic; the model decides. Reserves 1024 tokens of headroom.
#   none   omit thinkingConfig entirely, for models that reject the field.
#   (anything else falls back to 0)
#
# !! CRITICAL if you change GEMINI_MODEL !!
# gemini-2.5-pro CANNOT disable thinking and REQUIRES a budget of at least 128.
# Setting GEMINI_MODEL=gemini-2.5-pro while this stays at the default 0 returns a
# hard 400 on EVERY reply. Set GEMINI_THINKING_BUDGET=128 (or higher, or -1)
# together with the pro model.
GEMINI_THINKING_BUDGET=0

# ----------------------------- GROQ SETTINGS -----------------------------
# Groq Model name. Defaults to 'groq/compound' when blank.
GROQ_MODEL=

# GROQ_REASONING_EFFORT - low (default) | medium | high | none | default
# gpt-oss and other reasoning models charge their internal reasoning to the SAME
# max_completion_tokens budget as the visible reply. With AI_MAX_TOKENS sized for
# a 2-8 word WhatsApp message, a medium/high effort can consume the whole budget
# and return finish_reason:'length' with empty content - the bot then silently
# says nothing on ordinary messages. 'low' keeps replies flowing, and imitating
# someone's texting voice needs no chain of thought anyway.
# 'default' omits the field entirely, for models that reject it.
GROQ_REASONING_EFFORT=low

# ----------------------------- OLLAMA SETTINGS -----------------------------
# Local Ollama. OLLAMA_MODEL defaults to 'llama3.1:8b' when blank.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# OLLAMA_NUM_CTX - positive int, default 8192, sent as options.num_ctx.
# Ollama does NOT size the context window to the prompt. Left unset it applies its
# own server default (2048, or 4096 on newer builds) and silently truncates the
# FRONT of the prompt -- which is exactly where promptService puts the persona,
# dictionary, style, rules and the few-shot exemplars. Nothing errors and nothing
# is logged; the style instructions just vanish and the model answers as a generic
# assistant off the tail of the history. So this is set explicitly.
# The prompt AND the reply share this window (prompt + AI_MAX_TOKENS must fit).
# The default prompt shape runs ~15-16 KB of characters, roughly 4k tokens, so 8192
# leaves about 2x headroom. Raise it if HISTORY_MESSAGE_LIMIT or EXEMPLAR_LIMIT go
# much past their defaults; the cost is KV-cache RAM/VRAM, which grows with num_ctx.
OLLAMA_NUM_CTX=8192

# ----------------------------- SUPABASE DATABASE CONFIGS -----------------------------
# Postgress Database Configs
SUPABASE_URL=
SUPABASE_KEY=

# ----------------------------- PROMPT CONTEXT -----------------------------
# HISTORY_MESSAGE_LIMIT = how many past chat messages are replayed into the
# prompt on every reply. Defaults to 100. Larger = better recall, more tokens
# per request. Must be a positive integer; anything else falls back to 100.
# This window is deliberately unfiltered: both directions, and both human- and
# AI-authored rows, because conversation context needs them to stay coherent.
# On Ollama, raising this much past 100 means raising OLLAMA_NUM_CTX too.
HISTORY_MESSAGE_LIMIT=100

# EXEMPLAR_LIMIT = how many real, human-typed outgoing messages are shown to the
# model as few-shot style samples ("HOW I ACTUALLY TEXT"). Defaults to 20. Must be
# a positive integer; anything else falls back to 20.
# Unlike the history window above, this block IS provenance-gated: only OUTGOING
# rows with metadata.source = 'human' qualify, so the model never learns to imitate
# its own drift. Short, recent, non-URL, non-JSON messages are preferred.
# Raising it teaches the voice harder but costs tokens and starts pulling in
# longer, less characteristic messages; lowering it (or having too few human rows
# on a contact) weakens the voice, and at zero eligible rows the section is
# omitted entirely rather than emitted empty.
EXEMPLAR_LIMIT=20

# ----------------------------- DEBUGGING -----------------------------
# DEBUG=true logs the full outgoing payload for whichever provider is active.
# The payload includes the entire prompt: persona, summary, exemplars and chat
# history. Keep it false outside local debugging.
DEBUG=false
