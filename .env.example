# --- AI MODEL SELECTION ---
# AI_VERSION defines which model service to use (e.g. 'v1' for Gemini, 'v2' for Groq, 'ollama' for local Ollama)
AI_VERSION=v1

# --- API KEYS ---
# Gemini API Key (used when AI_VERSION=v1)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (used when AI_VERSION=v2)
GROQ_API_KEY=your_groq_api_key_here

# --- GROQ SETTINGS ---
# Groq Model name (defaults to "groq/compound" if not set)
# Common options: llama3-8b-8192, llama3-70b-8192, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama3-8b-8192

# --- OLLAMA SETTINGS ---
# Local Ollama Host URL (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# Local Ollama Model (defaults to llama3.1:8b)
OLLAMA_MODEL=llama3.1:8b

# --- SUPABASE DATABASE CONFIGS ---
# Supabase project URL
SUPABASE_URL=your_supabase_project_url_here
# Supabase service role key (or anon key depending on your row-level security policies)
SUPABASE_KEY=your_supabase_service_role_key_here

# --- DEBUGGING ---
# Set to 'true' to print detailed debug logs, messages, and payloads
DEBUG=false
